# Set these server-only values in Vercel project settings or a gitignored .env.local.
# Configure ONE provider key, or both to offer a choice. No AI Gateway key is needed.
OPENAI_API_KEY=
GEMINI_API_KEY=
# A random private team password of at least 16 characters. This is not an email OTP.
ICON_STUDIO_ACCESS_CODE=
# Optional defaults; override only with a model supported by the corresponding provider.
OPENAI_ICON_MODEL=gpt-6-sol
GEMINI_ICON_MODEL=gemini-3.8-flash
ICON_AI_PROVIDER=openai
